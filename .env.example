# ─────────────────────────────────────────────────────────────────────────────
# LedgerPilot — Environment Variables Example
# Copy this file to .env and fill in real values before running the project.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ledgerpilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ledgerpilot

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-use-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Redis (Phase 4 — not used in Phase 1) ────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Seed Data ─────────────────────────────────────────────────────────────────
# Development credentials — NEVER use in production
SEED_ADMIN_PASSWORD=Admin@123
SEED_MANAGER_PASSWORD=Manager@123
SEED_ANALYST_PASSWORD=Analyst@123
SEED_VIEWER_PASSWORD=Viewer@123

# ── Phase 3A: ML ──────────────────────────────────────────────────────────────
# Directory for trained model artifacts (relative to backend/ or absolute path)
MODELS_DIR=models
# Random seed for reproducible ML training
ML_RANDOM_SEED=42
# Embedding model — uses sentence-transformers (local, no API key required)
# Format: sentence-transformers/<model-name> or "openai" for OpenAI embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Embedding vector dimension (384 for all-MiniLM-L6-v2, 1536 for OpenAI)
EMBEDDING_DIM=384
# OpenAI API key — leave empty to use local sentence-transformers
OPENAI_API_KEY=

# ── Phase 3B: LLM / AI Finance Investigator ──────────────────────────────────
# Primary LLM provider: "gemini" (default) or "openai"
LLM_PROVIDER=gemini
# Google Gemini API key (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# LLM model name (leave empty to use provider default)
# Gemini default: gemini-2.0-flash | OpenAI default: gpt-4o-mini
LLM_MODEL=
# Agent safety limits
AI_MAX_CONTEXT_ITEMS=20
AI_MAX_TOOL_CALLS=15
# Confidence band thresholds
AI_CONFIDENCE_HIGH=0.90
AI_CONFIDENCE_MEDIUM=0.70
