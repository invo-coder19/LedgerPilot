# ─────────────────────────────────────────────────────────────────────────────
# LedgerPilot — Environment Variables Example
# Copy this file to .env and fill in real values before running the project.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ledgerpilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ledgerpilot

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-use-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Redis (Phase 4 — not used in Phase 1) ────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Seed Data ─────────────────────────────────────────────────────────────────
# Development credentials — NEVER use in production
SEED_ADMIN_PASSWORD=Admin@123
SEED_MANAGER_PASSWORD=Manager@123
SEED_ANALYST_PASSWORD=Analyst@123
SEED_VIEWER_PASSWORD=Viewer@123
